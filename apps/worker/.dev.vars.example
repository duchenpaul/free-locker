R2_ACCOUNT_ID=replace-with-r2-account-id
R2_ACCESS_KEY_ID=replace-with-scoped-r2-access-key-id
R2_SECRET_ACCESS_KEY=replace-with-scoped-r2-secret-access-key
R2_BUCKET_NAME=free-locker
