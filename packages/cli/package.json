{
  "name": "@free-locker/cli",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "free-locker": "./dist/index.js"
  },
  "scripts": {
    "build": "pnpm --filter @free-locker/shared build && tsc -p tsconfig.json",
    "dev": "tsx watch src/index.ts",
    "lint": "eslint src",
    "typecheck": "pnpm --filter @free-locker/shared build && tsc --noEmit",
    "test": "vitest run src"
  },
  "dependencies": {
    "@free-locker/shared": "workspace:*"
  },
  "devDependencies": {
    "tsx": "^4.20.5"
  }
}
